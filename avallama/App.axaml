<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="avallama.App"
             xmlns:dataTemplates="using:avallama.DataTemplates"
             RequestedThemeVariant="Light"
             x:Name="Avallama">

    <!-- Resource settings (app colors and font) -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Themes -->
                <MergeResourceInclude Source="/Resources/Themes/LightTheme.axaml" />
                <MergeResourceInclude Source="/Resources/Themes/DarkTheme.axaml" />

                <!-- Icons -->
                <MergeResourceInclude Source="/Resources/Icons.axaml" />

                <!-- Template selectors -->
                <MergeResourceInclude Source="/Resources/DataTemplates/ModelItemStatusSelector.axaml" />
                <MergeResourceInclude Source="/Resources/DataTemplates/ModelListItemSelector.axaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="Manrope">avares://avallama/Assets/Fonts#Manrope</FontFamily>
    </Application.Resources>

    <Application.Styles>

        <!-- Shared styles -->
        <StyleInclude Source="Styles/Shared.axaml" />

        <!-- Control styles -->
        <StyleInclude Source="Styles/Button.axaml" />
        <StyleInclude Source="Styles/TextBox.axaml" />
        <StyleInclude Source="Styles/TextBlock.axaml" />
        <StyleInclude Source="Styles/ComboBox.axaml" />
        <StyleInclude Source="Styles/ToggleSwitch.axaml" />
        <StyleInclude Source="Styles/DeletePopup.axaml" />
        <StyleInclude Source="Styles/Ellipse.axaml" />
        <StyleInclude Source="Styles/ListBox.axaml" />

        <!-- Templated controls -->
        <StyleInclude Source="Styles/TemplatedControls/ModelItem.axaml" />
        <StyleInclude Source="Styles/TemplatedControls/ModelListItem.axaml" />
        <StyleInclude Source="Styles/TemplatedControls/MessageItem.axaml" />
        <StyleInclude Source="Styles/TemplatedControls/ConversationItem.axaml" />

        <!-- Avalonia Fluent theme -->
        <FluentTheme />

    </Application.Styles>

    <Application.DataTemplates>

        <!-- View locator -->
        <dataTemplates:ViewLocator />

        <!-- Stateful template selector -->
        <dataTemplates:StatefulTemplateSelector />

    </Application.DataTemplates>

    <!-- Menu for macOS -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Avallama" Click="About_OnClick" />
        </NativeMenu>
    </NativeMenu.Menu>

</Application>
