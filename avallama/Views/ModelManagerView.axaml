<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:avallama.Services"
             xmlns:vm="using:avallama.ViewModels"
             xmlns:controls="clr-namespace:avallama.Controls"
             xmlns:converters="clr-namespace:avallama.Converters"
             xmlns:templatedControls="clr-namespace:avallama.Styles.TemplatedControls"
             xmlns:utilities="clr-namespace:avallama.Utilities"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="avallama.Views.ModelManagerView"
             x:DataType="vm:ModelManagerViewModel"
             Background="{DynamicResource Surface}"
             utilities:ViewInitialization.Command="{Binding InitializeAsync}">

    <UserControl.Resources>
        <converters:SortingOptionConverter x:Key="SortingOptionConverter" />
    </UserControl.Resources>

    <Grid Margin="22" RowDefinitions="Auto,*,Auto">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="225" MaxWidth="400" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title and info svg -->
        <StackPanel x:Name="PageTitle" Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Left" Margin="0,0,0,20">
            <TextBlock
                Text="{services:LocalizationService Key='MODEL_MANAGER'}" Classes="H1"
                Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center" />
            <Button Command="{Binding ShowInfo}" Classes="clearButton" Cursor="Hand">
                <PathIcon Data="{DynamicResource InfoFill}" Foreground="{DynamicResource OnSurfaceVariant}"
                                     Width="20" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <!-- Sidebar -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" HorizontalAlignment="Stretch">

            <!-- Search box -->
            <TextBox Grid.Row="0" Watermark="{services:LocalizationService Key='SEARCH_FOR_MODELS'}" MaxLines="1"
                     Padding="16,8"
                     HorizontalAlignment="Stretch" Text="{Binding SearchBoxText}"
                     VerticalAlignment="Stretch">
                <TextBox.InnerRightContent>
                    <PathIcon Data="{DynamicResource MagnifyingGlass}" Width="16"
                                         Margin="0,0,12,1" Foreground="{DynamicResource OnSurfaceVariant}" />
                </TextBox.InnerRightContent>
            </TextBox>

            <!-- Sorting and ordering combobox -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <TextBlock Grid.Column="0"
                           Text="{services:LocalizationService Key='SORT_BY'}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource OnSurface}"
                           FontWeight="Bold" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0"
                          HorizontalAlignment="Stretch"
                          Classes="sorting"
                          ItemsSource="{Binding SortingOptions}"
                          SelectedItem="{Binding Path=SelectedSortingOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource SortingOptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- "No models found" svg and text -->
            <StackPanel Grid.Row="2" Orientation="Vertical" IsVisible="{Binding !HasModelsToDisplay}"
                        Spacing="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:DynamicSvg Path="/Assets/Svg/sad.svg" Height="120" FillColor="{DynamicResource Primary}" />

                <TextBlock Text="{services:LocalizationService Key='NO_MODELS_FOUND'}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"
                           FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource Primary}"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- Model selection list -->
            <ScrollViewer Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,14,0,0"
                          AllowAutoHide="True">
                <StackPanel Orientation="Vertical" Spacing="12">
                    <ItemsControl ItemsSource="{Binding ModelItemViewModels}" VerticalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ModelItemViewModel">
                                <templatedControls:ModelListItem
                                    Margin="0,12,0,0"
                                    Title="{Binding Model.Name}"
                                    StatusText="{Binding ShortDownloadStatusText}"
                                    DownloadStatus="{Binding CurrentStatus}"
                                    SelectedName="{Binding $parent[UserControl].((vm:ModelManagerViewModel)DataContext).SelectedModelItemViewModel.Model.Name}"
                                    Command="{Binding $parent[UserControl].((vm:ModelManagerViewModel)DataContext).SelectModelCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pagination button (as a dots SVG) -->
                    <Button CornerRadius="8"
                            IsVisible="{Binding IsPaginationButtonVisible}"
                            Background="{DynamicResource SurfaceContainerHighest}" Padding="14,0"
                            Cursor="Hand" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Command="{Binding Paginate}">
                        <PathIcon Data="{DynamicResource DotsThreeOutline}"
                                             Foreground="{DynamicResource OnSecondaryContainer}"
                                             Height="26" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Opacity="0" ResizeDirection="Columns"
                      Margin="4,0,4,0" />

        <!-- Selected model view -->
        <templatedControls:ModelItem Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                     IsVisible="{Binding $parent[UserControl].((vm:ModelManagerViewModel)DataContext).IsModelInfoBlockVisible}"
                                     DataContext="{Binding SelectedModelItemViewModel}"
                                     Title="{Binding Model.Name}"
                                     Family="{Binding Model.Family}"
                                     Parameters="{Binding Model.Parameters}"
                                     InformationSource="{Binding Model.Info}"
                                     SizeInBytes="{Binding Model.Size}"
                                     DownloadStatus="{Binding CurrentStatus}"
                                     RunsSlow="{Binding Model.RunsSlow}"
                                     DownloadCommand="{Binding DownloadCommand}"
                                     PauseCommand="{Binding PauseCommand}"
                                     DeleteCommand="{Binding DeleteCommand}"
                                     CancelCommand="{Binding CancelCommand}"
                                     ResumeCommand="{Binding ResumeCommand}"
                                     RetryCommand="{Binding RetryCommand}"
                                     StatusText="{Binding LongDownloadStatusText}"
                                     SpeedText="{Binding DownloadSpeedText}"/>

        <!-- All downloaded models size -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Margin="0,22,0,0"
                   IsVisible="{Binding HasDownloadedModels}"
                   Text="{Binding DownloadedModelsInfo}"
                   Classes="H3" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0.6"
                   Foreground="{DynamicResource OnSurfaceVariant}" />

        <!-- Back button -->
        <Button Grid.Column="3" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,22,0,0"
                Content="{services:LocalizationService Key='BACK'}"
                Command="{Binding Path=((vm:MainViewModel)DataContext).OpenHome, RelativeSource={RelativeSource AncestorType=Window}}"
                Cursor="Hand" />
    </Grid>
</UserControl>
