<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="avallama.Views.ConversationView"
             xmlns:vm="clr-namespace:avallama.ViewModels"
             xmlns:controls="clr-namespace:avallama.Controls"
             xmlns:services="clr-namespace:avallama.Services"
             xmlns:models="clr-namespace:avallama.Models"
             xmlns:converters="clr-namespace:avallama.Converters"
             x:DataType="vm:ConversationViewModel">

    <UserControl.Resources>
        <converters:GenerationSpeedConverter x:Key="GenerationSpeedConverter" />
    </UserControl.Resources>

    <Grid>

        <!-- Initializing spinner -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsInitializing}">

            <controls:DynamicSvg Path="/Assets/Svg/spinner.svg"
                                 FillColor="{DynamicResource Primary}"
                                 Height="64" Margin="0,0,0,30"
                                 Classes="spinnerAnimation"
                                 IsVisible="{Binding IsInitializing}" />

            <TextBlock Text="{services:LocalizationService Key='LOADING_MESSAGES'}"
                       FontSize="18" />

        </StackPanel>

        <!-- View after initialization -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding !IsInitializing}">

            <!-- Top section (ComboBox + Info messages - ROW 1) -->
            <StackPanel Grid.Row="0">

                <!-- Available models ComboBox -->
                <ComboBox x:Name="ModelsComboBox"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MinWidth="175"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModelName, Mode=TwoWay}" />

                <!-- Informational messages -->
                <StackPanel Orientation="Vertical" Margin="18,10,18,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding ShowInformationalMessages}">

                    <!-- Remote connection info -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HorizontalAlignment="Center"
                          IsVisible="{Binding IsRemoteTextVisible}">
                        <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{DynamicResource Success}" />

                        <TextBlock Grid.Column="1" Text="{Binding RemoteText}"
                                   Foreground="{DynamicResource Success}"
                                   TextAlignment="Left"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- No available models warning -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" HorizontalAlignment="Center"
                          IsVisible="{Binding IsNoModelsTextVisible}">
                        <controls:DynamicSvg Grid.Column="0" Path="/Assets/Svg/info.svg"
                                             FillColor="{DynamicResource Error}"
                                             Width="18" />

                        <TextBlock Grid.Column="1" Text="{Binding NoModelsText}"
                                   Foreground="{DynamicResource Error}"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"
                                   x:Name="NoModelsWarningTextBlock" />
                    </Grid>

                </StackPanel>
            </StackPanel>

            <!-- Bottom section (Messages + Scroll to bottom button - ROW 2) -->
            <Grid Grid.Row="1" x:Name="ConversationGrid" HorizontalAlignment="Stretch"
                  Margin="0,15,0,0">

                <ScrollViewer x:Name="MessagesScrollViewer" ScrollChanged="ScrollViewer_OnScrollChanged">

                    <ItemsControl ItemsSource="{Binding Conversation.Messages}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="20" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.DataTemplates>

                            <!-- Specific message types need to be defined first, so the base Message type won't catch all -->

                            <!-- Failed message -->
                            <DataTemplate DataType="models:FailedMessage">

                                <Grid ColumnDefinitions="7*, 3*">
                                    <Border Grid.Column="0" Padding="16,12"
                                            Background="{DynamicResource SurfaceContainerHighest}"
                                            CornerRadius="12"
                                            HorizontalAlignment="Left"
                                            Classes="message">

                                        <StackPanel Orientation="Vertical" Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4"
                                                  HorizontalAlignment="Left">

                                                <!-- Error svg -->
                                                <controls:DynamicSvg Grid.Column="0" Path="/Assets/Svg/info.svg"
                                                                     FillColor="{DynamicResource Error}"
                                                                     Width="16" />

                                                <!-- Error message -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{services:LocalizationService Key='MESSAGE_GENERATION_FAILED'}"
                                                           Foreground="{DynamicResource Error}"
                                                           FontSize="14" TextAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           ContextFlyout="{x:Null}" />
                                            </Grid>

                                            <TextBlock Text="{Binding Content}"
                                                       Foreground="{DynamicResource OnSurface}"
                                                       FontSize="14" TextAlignment="Left"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />

                                            <Button Content="{services:LocalizationService Key='RETRY'}"
                                                    Command="{Binding $parent[UserControl].((vm:ConversationViewModel)DataContext).RetryMessageCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- Typing indicator message -->
                            <DataTemplate DataType="models:TypingIndicatorMessage">
                                <Grid ColumnDefinitions="7*, 3*">
                                    <Border Grid.Column="0" CornerRadius="20" Padding="16,12"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource SurfaceContainerHighest}"
                                            Classes="message">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Classes="typing-dot" Fill="{DynamicResource OnSurfaceVariant}" />
                                            <Ellipse Classes="typing-dot" Fill="{DynamicResource OnSurfaceVariant}" />
                                            <Ellipse Classes="typing-dot" Fill="{DynamicResource OnSurfaceVariant}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- Generated message -->
                            <DataTemplate DataType="models:GeneratedMessage">
                                <Grid ColumnDefinitions="7*, 3*">
                                    <Border Grid.Column="0"
                                            Padding="16,8"
                                            Background="{DynamicResource SurfaceContainerHighest}"
                                            CornerRadius="20"
                                            HorizontalAlignment="Left"
                                            Classes="message">
                                        <StackPanel Orientation="Vertical" Spacing="10">

                                            <!-- Message text -->
                                            <SelectableTextBlock
                                                Text="{Binding Content}"
                                                ContextFlyout="{x:Null}"
                                                FontSize="14"
                                                TextWrapping="Wrap"
                                                LineHeight="22"
                                                FontFamily="{StaticResource Manrope}"
                                                Foreground="{DynamicResource OnSurfaceVariant}" />

                                            <!-- Message subtext -->
                                            <TextBlock
                                                Text="{Binding GenerationSpeed, Converter={StaticResource GenerationSpeedConverter}}"
                                                TextWrapping="Wrap"
                                                FontFamily="{StaticResource Manrope}"
                                                Foreground="{DynamicResource OnSurfaceVariant}"
                                                HorizontalAlignment="Right"
                                                Opacity="0.5"
                                                FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>

                            <!-- User message -->
                            <DataTemplate DataType="models:Message">
                                <Grid ColumnDefinitions="3*, 7*">
                                    <Border Grid.Column="1"
                                            Padding="16,8"
                                            Background="{DynamicResource Primary}"
                                            CornerRadius="20"
                                            HorizontalAlignment="Right"
                                            Classes="message">

                                        <!-- Message text -->
                                        <SelectableTextBlock
                                            Text="{Binding Content}"
                                            ContextFlyout="{x:Null}"
                                            FontSize="14"
                                            LineHeight="22"
                                            TextWrapping="Wrap"
                                            FontFamily="{StaticResource Manrope}"
                                            Foreground="{DynamicResource OnPrimary}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>

                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Scroll to bottom button shadow -->
                <Border Width="40" Height="40" x:Name="ScrollToBottomBtnShadow"
                        Background="Transparent"
                        CornerRadius="24"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                        IsVisible="False" />

                <!-- Scroll to bottom button -->
                <Button x:Name="ScrollToBottomBtn" IsVisible="False" Classes="clearButton" Cursor="Hand"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Click="ScrollToBottomBtn_OnClick"
                        Margin="0,0,0,-5">
                    <Border Padding="4" Background="{DynamicResource Primary}" CornerRadius="24">
                        <controls:DynamicSvg
                            Path="/Assets/Svg/arrow-down.svg" Width="40" FillColor="{DynamicResource OnPrimary}" />
                    </Border>
                </Button>


            </Grid>

            <!-- Bottom section (Message textbox + LLM warning - ROW 3) -->
            <StackPanel Grid.Row="2" Orientation="Vertical">

                <!-- Message TextBox -->
                <TextBox x:Name="MessageTextBox"
                         Height="90"
                         Watermark="{services:LocalizationService Key='SEND_MESSAGE'}"
                         Margin="0,30,0,0"
                         Padding="14, 10"
                         CornerRadius="14"
                         Text="{Binding NewMessageText, Mode=TwoWay}"
                         IsEnabled="{Binding IsMessageBoxEnabled}">

                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding SendMessageCommand}" />
                    </TextBox.KeyBindings>

                    <TextBox.InnerRightContent>
                        <Grid Margin="0,10,10,0" VerticalAlignment="Top">

                            <!-- Send button -->
                            <Button Command="{Binding SendMessageCommand}"
                                    Classes="clearButton" IsVisible="{Binding !IsGenerating}"
                                    Cursor="Hand">
                                <Border Background="{DynamicResource Primary}"
                                        CornerRadius="8"
                                        Padding="6">
                                    <controls:DynamicSvg Path="/Assets/Svg/arrow-right.svg"
                                                         FillColor="{DynamicResource OnPrimary}"
                                                         Height="20" />
                                </Border>
                            </Button>

                            <!-- Stop button -->
                            <Button Command="{Binding CancelGenerationCommand}"
                                    Classes="clearButton" IsVisible="{Binding IsGenerating}"
                                    Cursor="Hand">
                                <Border Background="{DynamicResource Primary}"
                                        CornerRadius="8"
                                        Padding="8">
                                    <Rectangle Height="18" Width="18" Fill="{DynamicResource OnPrimary}" />
                                </Border>
                            </Button>

                        </Grid>
                    </TextBox.InnerRightContent>

                </TextBox>

                <!-- LLM response warning text -->
                <TextBlock Text="{services:LocalizationService Key='LLM_RESPONSE_WARNING'}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,8"
                           Opacity="0.7"
                           Foreground="{DynamicResource OnSurface}"
                           FontSize="11" />

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
