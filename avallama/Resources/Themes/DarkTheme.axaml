<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Color codes can be specified in the SolidColorBrush and Color tags. The Color tag also supports transparency. (#AA000000) -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="Background" Color="{StaticResource Neutral800}" />
            <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource Neutral700}" />
            <SolidColorBrush x:Key="SubCardBackground" Color="{StaticResource Neutral700}" />
            <SolidColorBrush x:Key="MainCardBackground" Color="{StaticResource Neutral600}" />

            <SolidColorBrush x:Key="OnboardingBackground" Color="{StaticResource Neutral800}" />

            <SolidColorBrush x:Key="Border" Color="{StaticResource Neutral600}" />

            <SolidColorBrush x:Key="Disabled" Color="{StaticResource Primary300}" Opacity="0.175"/>
            <SolidColorBrush x:Key="OnDisabled" Color="{StaticResource Primary400}" Opacity="0.6" />

            <SolidColorBrush x:Key="Primary" Color="{StaticResource Primary300}" />
            <SolidColorBrush x:Key="PrimaryHover" Color="{StaticResource Primary300}" Opacity="0.75" />
            <SolidColorBrush x:Key="PrimaryBorder" Color="Transparent" />
            <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource Primary700}" />

            <SolidColorBrush x:Key="Secondary" Color="{StaticResource Primary100}" />
            <SolidColorBrush x:Key="SecondaryHover" Color="{StaticResource Primary100}" Opacity="0.75" />
            <SolidColorBrush x:Key="SecondaryBorder" Color="Transparent" />
            <SolidColorBrush x:Key="OnSecondary" Color="{StaticResource Primary700}" />

            <SolidColorBrush x:Key="Tertiary" Color="{StaticResource Primary50}" />
            <SolidColorBrush x:Key="TertiaryHover" Color="{StaticResource Primary50}" Opacity="0.75" />
            <SolidColorBrush x:Key="TertiaryBorder" Color="Transparent" />
            <SolidColorBrush x:Key="OnTertiary" Color="{StaticResource Primary700}" />

            <SolidColorBrush x:Key="TextForeground" Color="{StaticResource Neutral50}" />
            <SolidColorBrush x:Key="TextOnBackground" Color="{StaticResource Neutral100}" />
            <SolidColorBrush x:Key="SubTextForeground" Color="{StaticResource Neutral200}" />

            <SolidColorBrush x:Key="InfoLabelBackground" Color="{StaticResource Info200}" />
            <SolidColorBrush x:Key="InfoLabelBorder" Color="Transparent" />
            <SolidColorBrush x:Key="OnInfoLabel" Color="{StaticResource Info700}" />

            <SolidColorBrush x:Key="Error" Color="{StaticResource Danger700}" />
            <SolidColorBrush x:Key="ErrorBackground" Color="{StaticResource Danger200}" />
            <SolidColorBrush x:Key="ErrorBorder" Color="Transparent" />
            <SolidColorBrush x:Key="OnError" Color="{StaticResource Danger700}" />

            <SolidColorBrush x:Key="NeutralIconFill" Color="{StaticResource Neutral300}" />

            <!-- TODO: remove before 0.4.0 -->
            <!-- Legacy dark theme colors (seed: #623079) -->
            <Color x:Key="Selection">#80755085</Color> <!-- 50% opacity -->
            <SolidColorBrush x:Key="SurfaceTint">#E4B7F3</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryContainer">#5C396C</SolidColorBrush>
            <SolidColorBrush x:Key="OnPrimaryContainer">#F7D8FF</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryContainer">#504255</SolidColorBrush>
            <SolidColorBrush x:Key="OnSecondaryContainer">#F1DCF4</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorContainer">#93000A</SolidColorBrush>
            <SolidColorBrush x:Key="OnErrorContainer">#FFDAD6</SolidColorBrush>
            <SolidColorBrush x:Key="Success">#1FA13D</SolidColorBrush>
            <SolidColorBrush x:Key="OnSuccess">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="OnBackground">#E9E0E7</SolidColorBrush>
            <SolidColorBrush x:Key="Surface">#161217</SolidColorBrush>
            <SolidColorBrush x:Key="OnSurface">#E9E0E7</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceVariant">#4C444D</SolidColorBrush>
            <SolidColorBrush x:Key="OnSurfaceVariant">#CEC3CD</SolidColorBrush>
            <SolidColorBrush x:Key="Outline">#978E97</SolidColorBrush>
            <SolidColorBrush x:Key="OutlineVariant">#4C444D</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceDim">#161217</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBright">#3D373D</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerLowest">#110D12</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerLow">#1E1A1F</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainer">#231E23</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerHigh">#2D282E</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerHighest">#383339</SolidColorBrush>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
