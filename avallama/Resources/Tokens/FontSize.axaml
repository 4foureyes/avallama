<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <system:Double x:Key="PageTitleFontSize">24</system:Double>
    <system:Double x:Key="PageSubTitleFontSize">16</system:Double>
    <system:Double x:Key="TextFontSize">14</system:Double>
    <system:Double x:Key="SubTextFontSize">14</system:Double>
    <system:Double x:Key="ButtonFontSize">12</system:Double>

</ResourceDictionary>
