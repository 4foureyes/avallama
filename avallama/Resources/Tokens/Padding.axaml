<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="ButtonPadding">20,10</Thickness>
    <Thickness x:Key="TextBoxPadding">14,10</Thickness>
    <Thickness x:Key="IconButtonPadding">8</Thickness>
    <Thickness x:Key="CardPadding">30</Thickness>
    <Thickness x:Key="SegmentedControlPadding">10</Thickness>

</ResourceDictionary>

