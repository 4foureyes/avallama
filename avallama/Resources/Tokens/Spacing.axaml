<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <system:Double x:Key="WelcomeSpacing">50</system:Double>
    <system:Double x:Key="WelcomeTextSpacing">8</system:Double>

    <system:Double x:Key="SpacingM">10</system:Double>
    <system:Double x:Key="SpacingL">20</system:Double>
    <system:Double x:Key="SpacingXL">30</system:Double>
    <system:Double x:Key="SpacingXXL">40</system:Double>

    <system:Double x:Key="InfoIconSpacing">4</system:Double>

</ResourceDictionary>
